{
  "name": "dsh-launcher",
  "version": "0.1.0",
  "description": "基于 DeepSeek Harness 构建的非官方桌面客户端",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "dshLauncher": {
    "nodeVersion": "24.14.1",
    "dshVersion": "0.1.0-rc.7"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "fetch:node": "node scripts/fetch-node-runtime.mjs",
    "fetch:dsh": "node scripts/fetch-dsh-bundle.mjs",
    "prepare:resources": "npm run fetch:node && npm run fetch:dsh",
    "pack": "npm run verify:resources && npm run build && electron-builder --win --x64",
    "make:icon": "node scripts/make-icon.mjs resources/icon.png",
    "verify:resources": "node scripts/verify-resources.mjs",
    "acceptance": "node scripts/acceptance.mjs \"release/win-unpacked/DSH启动器.exe\"",
    "check:single-instance": "node scripts/check-single-instance.mjs \"release/win-unpacked/DSH启动器.exe\"",
    "check:preload": "node scripts/check-preload.mjs \"release/win-unpacked/DSH启动器.exe\"",
    "verify:all": "npm run acceptance && npm run check:single-instance && npm run check:preload"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "4.1.11"
  }
}
